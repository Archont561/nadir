{
  "name": "@nadir/rust",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-wide Rust tasks. Per-crate clippy and nextest tasks live beside each crate so Turbo can select affected Rust packages; shared Cargo invocations stay here and are implemented by xtask.",
  "license": "MIT",
  "scripts": {
    "build": "cargo run --quiet --package xtask -- build --workspace",
    "build:release": "cargo run --quiet --package xtask -- build --workspace --release",
    "typecheck": "cargo run --quiet --package xtask -- check --workspace --all-targets",
    "lint": "bun run lint:fmt && bun run lint:deps",
    "lint:fmt": "cargo run --quiet --package xtask -- fmt --check",
    "lint:deps": "cargo run --quiet --package xtask -- deny",
    "lint:advisories": "cargo run --quiet --package xtask -- deny advisories",
    "fmt": "cargo run --quiet --package xtask -- fmt",
    "test:all": "cargo run --quiet --package xtask -- test --workspace",
    "test:unit:all": "cargo run --quiet --package xtask -- test --workspace --no-doc",
    "test:doc:all": "cargo run --quiet --package xtask -- test --workspace --doc-only",
    "coverage": "cargo run --quiet --package xtask -- coverage --workspace --output-path lcov.info",
    "cov": "bun run coverage",
    "doc": "cargo run --quiet --package xtask -- doc --workspace",
    "advisories": "cargo run --quiet --package xtask -- deny advisories bans licenses sources"
  }
}
