{
  "name": "@nadir/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Native TypeScript bindings for the nadir engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "*.node"],
  "scripts": {
    "build:native": "cargo run --quiet --package xtask -- native node --release",
    "build:native:release": "cargo run --quiet --package xtask -- native node --release",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "biome check .",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "cov": "bun run coverage",
    "fmt": "biome format --write .",
    "advisories": "echo 'Native dependencies are audited through Cargo.lock'"
  },
  "napi": {
    "binaryName": "nadir-node-native",
    "targets": ["x86_64-unknown-linux-gnu"]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
