{
  "$schema": "https://turborepo.com/schema.json",
  "name": "nadir",
  "version": "0.1.0",
  "private": true,
  "description": "Artifact-driven photogrammetry pipeline engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archont561/nadir.git"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": ["packages/*", "python/*", "crates", "crates/*"],
  "scripts": {
    "build": "turbo run build",
    "build:release": "turbo run build:release",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "coverage": "turbo run coverage",
    "cov": "bun run coverage",
    "lint": "turbo run lint lint:biome lint:actions",
    "fmt": "turbo run fmt fmt:biome",
    "advisories": "turbo run advisories",
    "dev": "turbo run dev",
    "all:build": "bun run build",
    "all:lint": "bun run lint",
    "all:typecheck": "bun run typecheck",
    "all:test": "bun run test",
    "all:cov": "bun run coverage",
    "all:fmt": "bun run fmt",
    "all:advisories": "bun run advisories",
    "gates": "turbo run lint lint:biome lint:actions typecheck test",
    "lint:biome": "biome check .",
    "lint:actions": "actionlint",
    "fmt:biome": "biome format --write .",
    "lint:rust": "turbo run lint --filter=@nadir/rust --filter=@nadir/rust-*",
    "test:rust": "turbo run test --filter=@nadir/rust-*",
    "test:affected": "turbo run test --affected",
    "lint:affected": "turbo run lint lint:biome lint:actions --affected",
    "build:native": "turbo run build:native --filter=@nadir/sdk",
    "build:native:release": "turbo run build:native:release --filter=@nadir/sdk"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "backlog.md": "^1.53.0",
    "skills": "^1.7.0",
    "turbo": "2.11.5"
  }
}
